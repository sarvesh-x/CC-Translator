# DeepSeek API (online, optional). Create your own key from the official DeepSeek platform.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# LibreTranslate (online/self-hosted, optional)
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# Qwen3 via local Ollama (free, private, natural Hindi; model must be pulled once)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=300

# Network behavior
REQUEST_TIMEOUT=45
REQUEST_RETRIES=4
TRANSLATION_BATCH_SIZE=12
